# Copy this file to `.env` in your Claude Code workspace root, then fill in your own keys.
# Your real .env is gitignored and must never be committed.

# Apify — STRONGLY RECOMMENDED. Powers the bulk LinkedIn bio pre-fetch, the skill's
# main signal source (~$4 per 1,000 profiles).
# Token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_your-token-here

# Firecrawl — OPTIONAL. Used only when a prospect site blocks a plain fetch AND
# LinkedIn gave nothing. The skill runs without it, just with slightly lower yield.
# Get one at https://www.firecrawl.dev
FIRECRAWL_API_KEY=fc-your-key-here
